{
  "name": "jdlabs-ai-engine",
  "version": "1.0.0",
  "description": "JDLabs AI Engine - Backend API for AI-powered interview system",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "dev": "nodemon --watch src --exec 'npm run build && npm start'",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "generate-openapi": "tsc && node dist/scripts/generateOpenAPI.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write 'src/**/*.{ts,js,json}'"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.43.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "swagger-ui-express": "^5.0.0",
    "openapi-typescript": "^6.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ai",
    "interview",
    "voice",
    "gemini",
    "ollama",
    "websocket"
  ],
  "author": "JDLabs Team",
  "license": "MIT"
}