# JDLabs Environment Configuration (Local AI Stack)
# Copy this file to .env and fill in your values

# ===========================================
# AI BACKEND CONFIGURATION
# ===========================================
# Options: 'local' or 'gemini'
# Use 'local' for Ollama+Whisper+TTS stack
# Use 'gemini' for Google Gemini Live API
AI_BACKEND=gemini

# ===========================================
# LOCAL AI SERVICES (for AI_BACKEND=local)
# ===========================================
OLLAMA_URL=http://localhost:11434
WHISPER_URL=http://localhost:9000

# Ollama Model Configuration
OLLAMA_MODEL=gemma2:2b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Whisper Configuration
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# ===========================================
# TTS (Text-to-Speech) CONFIGURATION
# ===========================================
# TTS Engine: 'kani' (recommended) or 'piper' (legacy)
TTS_ENGINE=kani

# Kani-TTS Configuration (Default)
KANI_TTS_URL=http://localhost:10400
KANI_TTS_SAMPLE_RATE=22050

# Piper Configuration (Legacy - Not Recommended)
# PIPER_URL=http://localhost:10200
# PIPER_VOICE=en_US-lessac-medium
# PIPER_SAMPLE_RATE=24000

